import re

def is_valid_email(email: str) -> bool:
    """Determine whether the given email string is valid.

    This function verifies that an email address conforms to standard
    formatting rules for both local and domain parts.

    Parameters
    ----------
    email : str
        The email address to validate.

    Returns
    -------
    bool
        True if the email is valid, False otherwise.
    """
    if not isinstance(email, str):
        return False

    email = email.strip()
    MAX_EMAIL_LEN = 254
    MAX_LOCAL_LEN = 64

    if not email or len(email) > MAX_EMAIL_LEN:
        return False

    parts = email.split('@')
    if len(parts) != 2:
        return False

    local, domain = parts

    if not local or not domain or len(local) > MAX_LOCAL_LEN:
        return False

    if '..' in local:
        return False
    local_regex = r'^[A-Za-z0-9](?:[A-Za-z0-9._%+-]*[A-Za-z0-9])?$'
    if not re.fullmatch(local_regex, local):
        return False

    if '..' in domain:
        return False
    domain_regex = r'^(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$'
    if not re.fullmatch(domain_regex, domain):
        return False

    return True

if __name__ == "__main__":
    test_emails = [
