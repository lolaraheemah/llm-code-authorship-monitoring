def word_frequency(input_text):
    """Calculate the frequency of each word in the provided text.

    Args:
        input_text (str): The text to analyze.

    Returns:
        dict: A dictionary mapping each word to its frequency.
    """
    PUNCTUATION_MARKS = ".,!?;:'\"()[]{}"
    word_count = {}

    for raw_word in input_text.lower().split():
        # Remove surrounding punctuation from the word
        cleaned_word = raw_word.strip(PUNCTUATION_MARKS)
        if cleaned_word:
            try:
                word_count[cleaned_word] += 1
            except KeyError:
                word_count[cleaned_word] = 1

    return word_count

# Demonstration
sample_text = "Hello world! Hello Python. Python is great."
print(word_frequency(sample_text))
# Expected output: {'hello': 2, 'world': 1, 'python': 2, 'is': 1, 'great': 1}