from typing import Iterable, List, Any

def remove_duplicates(input_iterable: Iterable[Any]) -> List[Any]:
    """
    Removes duplicate elements from an iterable while preserving order.

    Parameters
    ----------
    input_iterable : Iterable[Any]
        The input collection of items to deduplicate.

    Returns
    -------
    List[Any]
        A new list with duplicates removed, preserving original order.

    Notes
    -----
    Raises TypeError if input_iterable is not iterable.
    """
    seen_items = set()
    deduplicated_list = []

    # Process each item, adding to result only if not previously seen
    for current_item in input_iterable:
        if current_item not in seen_items:
            seen_items.add(current_item)
            deduplicated_list.append(current_item)

    return deduplicated_list

# Demonstration
sample_input = [1, 2, 2, 3, 4, 3, 5, 1]
print(remove_duplicates(sample_input))
# Output: [1, 2, 3, 4, 5]